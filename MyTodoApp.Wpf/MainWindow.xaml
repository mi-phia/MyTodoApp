<Window
    x:Class="MyTodoApp.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MyTodoApp.Wpf"
    xmlns:core="clr-namespace:MyTodoApp;assembly=MyTodoApp.Core"
    mc:Ignorable="d"
    Title="My Todo App"
    Width="1000"
    Height="750"
    MinWidth="750"
    MinHeight="600"

    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 入力欄のデザイン -->
        <Style x:Key="InputTextBoxStyle"
           TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>

        <!-- ComboBoxのデザイン -->
        <Style x:Key="InputComboBoxStyle"
           TargetType="{x:Type ComboBox}">

            <Setter Property="Height" Value="27"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>

        <!-- DatePickerのデザイン -->
        <Style x:Key="InputDatePickerStyle"
           TargetType="{x:Type DatePicker}">

            <Setter Property="Height" Value="27"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>

        </Style>

        <!-- 追加ボタンのデザイン -->
        <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#1D4ED8"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                        Value="#1E40AF"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background"
                        Value="#94A3B8"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- 編集ボタンのデザイン -->
        <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- 削除ボタンのデザイン -->
        <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#FECACA"/>
                </Trigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タスク追加フォーム -->
        <StackPanel
            Grid.Row="0"
            Orientation="Vertical"
            Margin="0,0,0,16">

            <!-- アプリタイトル -->
            <TextBlock
                Text="My Todo List"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,0,0,16"/>

            <!-- タスク名 -->
            <TextBlock
                Text="タスク名"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="TaskInputTextBox"
                Width="300"
                Style="{StaticResource InputTextBoxStyle}"
                HorizontalAlignment="Left"
                MaxLength="100"/>

            <!-- 期限と優先度 -->
            <Grid Margin="0,10,0,0">

                <!-- 横方向への分割 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- 期限 -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="期限"
                        FontWeight="Bold"
                        Margin="0,0,0,5"/>

                    <DatePicker
                        x:Name="DueDatePicker"
                        Width="180"
                        HorizontalAlignment="Left"
                        Style="{StaticResource InputDatePickerStyle}"/>

                </StackPanel>

                <!-- 優先度 -->
                <StackPanel Grid.Column="1">

                    <TextBlock
                        Text="優先度"
                        FontWeight="Bold"
                        Margin="0,0,0,5"/>

                    <ComboBox
                        x:Name="PriorityComboBox"
                        Width="180"
                            Style="{StaticResource InputComboBoxStyle}"
                        SelectedIndex="1"
                        HorizontalAlignment="Left">

                        <ComboBoxItem Content="低"/>
                        <ComboBoxItem Content="中"/>
                        <ComboBoxItem Content="高"/>

                    </ComboBox>

                </StackPanel>

            </Grid>

            <!-- 追加ボタン -->
            <Button
                x:Name="AddButton"
                Content="追加"
                Width="100"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Click="AddButtun_Click"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タスク一覧のタイトル と検索欄 -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,10">

                <TextBlock
                    Text="タスク一覧"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="タスク名で検索"
                    Margin="0,0,0,5"/>

                <TextBox
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Width="300"
                    Style="{StaticResource InputTextBoxStyle}"
                    HorizontalAlignment="Left"/>

                <!-- 絞り込み条件 -->
                    <TextBlock
                    Text="表示するタスク"
                    Margin="0,10,0,5"/>

                <ComboBox
                    Width="180"
                    HorizontalAlignment="Left"
                    SelectedIndex="{Binding FilterMode, Mode=TwoWay}">

                    <ComboBoxItem Content="すべて"/>
                    <ComboBoxItem Content="未完了"/>
                    <ComboBoxItem Content="完了済み"/>
                    <ComboBoxItem Content="期限切れ"/>

                </ComboBox>

                <!-- 並び替え -->
                <TextBlock
                    Text="並び替え"
                    Margin="0,10,0,5"/>

                <ComboBox
                    Width="180"
                    HorizontalAlignment="Left"
                    SelectedIndex="{Binding SortMode, Mode=TwoWay}">

                    <ComboBoxItem Content="登録順"/>
                    <ComboBoxItem Content="期限が近い順"/>
                    <ComboBoxItem Content="優先度が高い順"/>

                </ComboBox>

            </StackPanel>

            <!-- タスク一覧 -->
            <Grid Grid.Row="1">

                <ListBox      
                    x:Name="TaskListBox"
                    ItemsSource="{Binding TodosView}"
                    MinHeight="220"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <!-- 1件のタスクを囲むBorder -->
                            <Border
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1"
                                Padding="8,6"
                                MinHeight="44">

                                <Grid VerticalAlignment="Center">

                                    <!-- 5列に分割 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- タスク名 -->
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                        Checked="TaskCheckBox_Changed"
                                        Unchecked="TaskCheckBox_Changed"
                                        VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Title}">

                                            <!-- 完了状態による文字の変更 -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="Black"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsCompleted}"
                                                            Value="True">

                                                            <Setter
                                                            Property="Foreground"
                                                            Value="Gray"/>

                                                            <Setter
                                                            Property="TextDecorations"
                                                            Value="Strikethrough"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </CheckBox>

                                    <!-- 期限 -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DueDate, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue=未設定}"
                                        VerticalAlignment="Center"/>

                                    <!-- 優先度 -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,3"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <Setter
                                                    Property="Background"
                                                    Value="#DCFCE7"/>

                                                <Style.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.High}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#FEE2E2"/>

                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.Medium}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#FEF3C7"/>

                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.Low}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#DCFCE7"/>

                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock
                                            Text="{Binding Priority}"
                                            FontWeight="SemiBold">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="#15803D"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding Priority}"
                                                            Value="{x:Static core:TodoPriority.High}">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="#B91C1C"/>

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            Binding="{Binding Priority}"
                                                            Value="{x:Static core:TodoPriority.Medium}">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="#B45309"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </Border>

                                    <!-- 編集ボタン -->
                                    <Button
                                        Grid.Column="3"
                                        Content="編集"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditButton_Click"
                                        Margin="2,0"/>

                                    <!-- 削除ボタン -->
                                    <Button
                                        Grid.Column="4"
                                        Content="削除"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteButton_Click"
                                        Margin="2,0"/>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>


                </ListBox>

                <!-- タスクが0件の場合のメッセージ -->
                <TextBlock
                    Text="表示できるタスクがありません&#x0a;検索条件を変更するか、新しいタスクを追加してください。"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="Gray"
                    FontSize="14"
                    IsHitTestVisible="False">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding TodosView.IsEmpty}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

            </Grid>
            <!-- 操作結果の表示 -->
            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0">

                <!-- DBから読み込んだ件数 -->
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        Text="{Binding Todos.Count}"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="件のタスクを読み込みました"/>

                </StackPanel>

                <!-- タスクの操作結果 -->
                <TextBlock
                    x:Name="TaskStatusTextBlock"
                    Text="タスクの状態がここに表示されます"
                    Foreground="Gray"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
