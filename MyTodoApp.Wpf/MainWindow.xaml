<Window
    x:Class="MyTodoApp.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MyTodoApp.Wpf"
    xmlns:core="clr-namespace:MyTodoApp;assembly=MyTodoApp.Core"
    mc:Ignorable="d"
    Title="My Todo App"
    FontFamily="BIZ UDゴシック"
    Width="1000"
    Height="750"
    MinWidth="750"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing">

    <Window.Resources>

        <!-- ボタン共通の角丸デザイン -->
        <ControlTemplate
            x:Key="RoundedButtonTemplate"
            TargetType="{x:Type Button}">

            <Border
                CornerRadius="6"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Margin="{TemplateBinding Padding}"
                    RecognizesAccessKey="True"/>

            </Border>

        </ControlTemplate>

        <!-- 入力欄の角丸デザイン -->
        <Style x:Key="InputTextBoxStyle"
            TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <!-- 入力欄の形状 -->
            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border
                            x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"/>

                        </Border>

                        <!-- 状態によるデザイン変更 -->
                        <ControlTemplate.Triggers>

                            <!-- マウスを合わせたとき -->
                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="#93C5FD"/>

                            </Trigger>

                            <!-- 入力欄を選択したとき -->
                            <Trigger Property="IsKeyboardFocused" Value="True">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="#60A5FA"/>

                            </Trigger>

                            <!-- 無効状態 -->
                            <Trigger Property="IsEnabled" Value="False">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="Opacity"
                                    Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        
        <!-- ComboBoxの選択肢のデザイン -->
        <Style x:Key="InputComboBoxItemStyle"
            TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                RecognizesAccessKey="True"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- マウスを合わせたとき -->
                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#EFF6FF"/>

                                <Setter
                                    Property="Foreground"
                                    Value="#1D4ED8"/>

                            </Trigger>

                            <!-- 選択されているとき -->
                            <Trigger Property="IsSelected" Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#DBEAFE"/>

                                <Setter
                                    Property="Foreground"
                                    Value="#1D4ED8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ComboBox本体のデザイン -->
        <Style x:Key="InputComboBoxStyle"
            TargetType="{x:Type ComboBox}">

            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle"
            Value="{StaticResource InputComboBoxItemStyle}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <!-- 外枠 -->
                            <Border
                                x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>

                            <!-- 下向き矢印 -->
                            <ToggleButton
                                Grid.Column="1"
                                Focusable="False"
                                ClickMode="Press"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="{x:Type ToggleButton}">

                                        <Border Background="Transparent">

                                            <Path
                                                Width="9"
                                                Height="5"
                                                Stretch="Fill"
                                                Fill="#64748B"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                Data="M 0,0 L 4.5,5 L 9,0 Z"/>

                                        </Border>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <!-- 選択された項目の表示 -->
                            <ContentPresenter
                                x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="10,0,30,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                            <!-- 選択肢の一覧 -->
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade">

                                <Border
                                    Margin="0,4,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="180"

                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <ScrollViewer
                                        CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- マウスを合わせたとき -->
                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ComboBorder"
                                    Property="BorderBrush"
                                    Value="#93C5FD"/>

                            </Trigger>

                            <!-- キーボードでフォーカスしたとき -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter
                                    TargetName="ComboBorder"
                                    Property="BorderBrush"
                                    Value="#60A5FA"/>

                            </Trigger>

                            <!-- 無効状態 -->
                            <Trigger Property="IsEnabled" Value="False">

                                <Setter
                                    TargetName="ComboBorder"
                                    Property="Opacity"
                                    Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- DatePickerの角丸デザイン -->
        <Style x:Key="InputDatePickerStyle"
            TargetType="{x:Type DatePicker}">

            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <!-- DatePickerの外観 -->
            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type DatePicker}">

                        <Grid x:Name="PART_Root">

                            <!-- 外枠 -->
                            <Border
                                x:Name="DatePickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <!-- 日付入力欄 -->
                                <DatePickerTextBox
                                    x:Name="PART_TextBox"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,2"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    VerticalContentAlignment="Center"/>

                                <!-- カレンダーボタン -->
                                <Button
                                    x:Name="PART_Button"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Background="Transparent"
                                    BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                            <Border
                                                x:Name="CalendarButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="0,5,5,0">

                                                <!-- カレンダーアイコン -->
                                                <Path
                                                    x:Name="CalendarIcon"
                                                    Width="16"
                                                    Height="16"
                                                    Stroke="#64748B"
                                                    StrokeThickness="1.4"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    Stretch="Uniform"
                                                    Data="M 3,2 L 13,2 L 13,14 L 3,14 Z M 6,0 L 6,4 M 10,0 L 10,4 M 3,5 L 13,5"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <!-- マウスオーバー時 -->
                                                <Trigger
                                                    Property="IsMouseOver"
                                                    Value="True">

                                                    <Setter
                                                        TargetName="CalendarButtonBorder"
                                                        Property="Background"
                                                        Value="#EFF6FF"/>

                                                    <!-- アイコンを青色に変更 -->
                                                    <Setter
                                                        TargetName="CalendarIcon"
                                                        Property="Stroke"
                                                        Value="#2563EB"/>

                                                </Trigger>

                                                <!-- クリック時 -->
                                                <Trigger
                                                    Property="IsPressed"
                                                    Value="True">

                                                    <Setter
                                                        TargetName="CalendarButtonBorder"
                                                        Property="Background"
                                                        Value="#DBEAFE"/>

                                                    <!-- アイコンを濃い青色に変更 -->
                                                    <Setter
                                                        TargetName="CalendarIcon"
                                                        Property="Stroke"
                                                        Value="#1D4ED8"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </Grid>

                            <!-- カレンダー表示領域 -->
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=PART_TextBox}"
                                StaysOpen="False"
                                AllowsTransparency="True"/>

                        </Grid>

                        <!-- 状態による枠線の変更 -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="DatePickerBorder"
                                    Property="BorderBrush"
                                    Value="#93C5FD"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter
                                    TargetName="DatePickerBorder"
                                    Property="BorderBrush"
                                    Value="#60A5FA"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter
                                    TargetName="DatePickerBorder"
                                    Property="Opacity"
                                    Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- 追加ボタンのデザイン -->
        <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FF8DC8FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#79b9ff"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                        Value="#1E40AF"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background"
                        Value="#94A3B8"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- 編集ボタンのデザイン -->
        <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- 削除ボタンのデザイン -->
        <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}">

            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="#FECACA"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- 入力リセットボタンのデザイン -->
        <Style x:Key="ResetButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#FFD63131"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter
                Property="Template"
                Value="{StaticResource RoundedButtonTemplate}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                    Value="#FECACA"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                    Value="#FCA5A5"/>
                </Trigger>

            </Style.Triggers>

        </Style>     

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タスク追加フォーム -->
        <StackPanel
            Grid.Row="0"
            Orientation="Vertical"
            Margin="0,0,0,16">

            <!-- アプリタイトル -->
            <TextBlock
                Text="My Todo List"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,0,0,16"/>

            <!-- タスク名 -->
            <TextBlock
                Text="タスク名"
                FontWeight="Bold"
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="TaskInputTextBox"
                Width="300"
                Style="{StaticResource InputTextBoxStyle}"
                HorizontalAlignment="Left"
                MaxLength="100"/>

            <!-- 期限と優先度 -->
            <Grid Margin="0,10,0,0">

                <!-- 横方向への分割 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- 期限 -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="期限"
                        FontWeight="Bold"
                        Margin="0,0,0,5"/>

                    <DatePicker
                        x:Name="DueDatePicker"
                        Width="180"
                        HorizontalAlignment="Left"
                        Style="{StaticResource InputDatePickerStyle}"/>

                </StackPanel>

                <!-- 優先度 -->
                <StackPanel Grid.Column="1">

                    <TextBlock
                        Text="優先度"
                        FontWeight="Bold"
                        Margin="0,0,0,5"/>

                    <ComboBox
                        x:Name="PriorityComboBox"
                        Width="180"
                            Style="{StaticResource InputComboBoxStyle}"
                        SelectedIndex="1"
                        HorizontalAlignment="Left">

                        <ComboBoxItem Content="低"/>
                        <ComboBoxItem Content="中"/>
                        <ComboBoxItem Content="高"/>

                    </ComboBox>

                </StackPanel>

            </Grid>

            <!-- 追加・入力リセットボタン -->
            <StackPanel
                Orientation="Horizontal"
                Margin="0,10,0,0">

                <!-- 追加・更新ボタン -->
                <Button
                    x:Name="AddButton"
                    Content="追加"
                    Width="100"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="AddButtun_Click"/>

                <!-- 入力リセットボタン -->
                <Button
                    x:Name="ResetButton"
                    Content="リセット"
                    Style="{StaticResource ResetButtonStyle}"
                    Margin="8,0,0,0"
                    Click="ResetButton_Click"/>

            </StackPanel>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タスク一覧のタイトル と検索欄 -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,10">

                <TextBlock
                    Text="タスク一覧"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="タスク名で検索"
                    Margin="0,0,0,5"/>

                <TextBox
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Width="300"
                    Style="{StaticResource InputTextBoxStyle}"
                    HorizontalAlignment="Left"/>

                <!-- 絞り込み条件・並び替え -->
                <Grid Margin="0,10,0,10">

                    <!-- 2列に分割 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- 表示するタスク -->
                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="表示するタスク"
                            Margin="0,0,0,5"/>

                        <ComboBox
                            Width="180"
                            HorizontalAlignment="Left"
                            Style="{StaticResource InputComboBoxStyle}"
                            SelectedIndex="{Binding FilterMode, Mode=TwoWay}">

                            <ComboBoxItem Content="すべて"/>
                            <ComboBoxItem Content="未完了"/>
                            <ComboBoxItem Content="完了済み"/>
                            <ComboBoxItem Content="期限切れ"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- 並び替え -->
                    <StackPanel Grid.Column="1">

                        <TextBlock
                            Text="並び替え"
                            Margin="0,0,0,5"/>

                        <ComboBox
                            Width="180"
                            HorizontalAlignment="Left"
                            Style="{StaticResource InputComboBoxStyle}"
                            SelectedIndex="{Binding SortMode, Mode=TwoWay}">

                            <ComboBoxItem Content="登録順"/>
                            <ComboBoxItem Content="期限が近い順"/>
                            <ComboBoxItem Content="優先度が高い順"/>

                        </ComboBox>

                    </StackPanel>

                </Grid>
            </StackPanel>
                <!-- タスク一覧 -->
            <Grid Grid.Row="1">

                <!-- タスク一覧の外枠 -->
                <Border
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF"
                    ClipToBounds="True">

                    <ListBox
                        x:Name="TaskListBox"
                        ItemsSource="{Binding TodosView}"
                        MinHeight="220"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.CanContentScroll="False">

                    <!-- スクロール領域の設定 -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Margin="0,0,0,180"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BorderThickness="0,0,0,1"
                                Padding="8,6"
                                MinHeight="44"
                                Margin="0,2"
                                CornerRadius="6">

                                <!-- マウスオーバー時のデザイン -->
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">

                                        <!-- 通常時 -->
                                        <Setter
                                            Property="Background"
                                            Value="Transparent"/>

                                        <Setter
                                            Property="BorderBrush"
                                            Value="#E2E8F0"/>

                                        <Style.Triggers>

                                            <!-- マウスを合わせたとき -->
                                            <DataTrigger
                                                Binding="{Binding IsMouseOver,
                                                RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                Value="True">

                                                <!-- 背景色 -->
                                                <Setter
                                                    Property="Background"
                                                    Value="#EFF6FF"/>

                                                <!-- 枠線 -->
                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="#BFDBFE"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </Border.Style>

                                <Grid VerticalAlignment="Center">

                                    <!-- 5列に分割 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- タスク名 -->
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                        Checked="TaskCheckBox_Changed"
                                        Unchecked="TaskCheckBox_Changed"
                                        VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Title}">

                                            <!-- 完了状態による文字の変更 -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="Black"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsCompleted}"
                                                            Value="True">

                                                            <Setter
                                                            Property="Foreground"
                                                            Value="Gray"/>

                                                            <Setter
                                                            Property="TextDecorations"
                                                            Value="Strikethrough"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </CheckBox>

                                    <!-- 期限 -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DueDate, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue=未設定}"
                                        VerticalAlignment="Center">

                                        <!-- 期限切れによる文字色の変更 -->
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <!-- 通常時の文字色 -->
                                                <Setter
                                                    Property="Foreground"
                                                    Value="#334155"/>

                                                <Style.Triggers>

                                                    <!-- 期限切れの場合 -->
                                                    <DataTrigger
                                                        Binding="{Binding IsOverdue}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="#DC2626"/>

                                                        <Setter
                                                            Property="FontWeight"
                                                            Value="Bold"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                    <!-- 優先度 -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,1"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <Setter
                                                    Property="Background"
                                                    Value="#DCFCE7"/>

                                                <Style.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.High}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#FEE2E2"/>

                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.Medium}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#FEF3C7"/>

                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding Priority}"
                                                        Value="{x:Static core:TodoPriority.Low}">

                                                        <Setter
                                                            Property="Background"
                                                            Value="#DCFCE7"/>

                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock
                                            Text="{Binding Priority}"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="#15803D"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding Priority}"
                                                            Value="{x:Static core:TodoPriority.High}">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="#B91C1C"/>

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            Binding="{Binding Priority}"
                                                            Value="{x:Static core:TodoPriority.Medium}">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="#B45309"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>
                                    </Border>

                                    <!-- 編集ボタン -->
                                    <Button
                                        Grid.Column="3"
                                        Content="編集"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditButton_Click"
                                        Margin="2,0"/>

                                    <!-- 削除ボタン -->
                                    <Button
                                        Grid.Column="4"
                                        Content="削除"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteButton_Click"
                                        Margin="2,0"/>                                   
                                
                                </Grid>
                            
                            </Border>
                     
                        </DataTemplate>
                    
                    </ListBox.ItemTemplate>

                    </ListBox>
                    
                </Border>

                <!-- タスクが0件の場合のメッセージ -->
                <TextBlock
                    Text="表示できるタスクがありません&#x0a;検索条件を変更するか、新しいタスクを追加してください。"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="Gray"
                    FontSize="14"
                    IsHitTestVisible="False">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock">
                            <Setter
                                Property="Visibility"
                                Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding TodosView.IsEmpty}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

            </Grid>
            <!-- 操作結果の表示 -->
            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0">

                <!-- DBから読み込んだ件数 -->
                <StackPanel Orientation="Horizontal">

                    <TextBlock
                        Text="{Binding Todos.Count}"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="件のタスクを読み込みました"/>

                </StackPanel>

                <!-- タスクの操作結果 -->
                <TextBlock
                        x:Name="TaskStatusTextBlock"
                        Text="タスクの状態がここに表示されます"
                        Foreground="Gray"
                        Margin="0,5,0,0"/>

                <!-- データ管理 -->
                <TextBlock
                    Text="データ管理"
                    FontWeight="Bold"
                    Margin="0,15,0,5"/>

                <!-- バックアップ関連ボタン -->
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,5,0,0">

                    <!-- バックアップ作成 -->
                    <Button
                        x:Name="BackupButton"
                        Content="バックアップ作成"
                        Width="140"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="BackupButton_Click"/>

                    <!-- バックアップ復元 -->
                    <Button
                        x:Name="RestoreButton"
                        Content="バックアップ復元"
                        Width="160"
                        Height="36"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="8,0,0,0"
                        Click="RestoreButton_Click"/>

                </StackPanel>
                
            </StackPanel>

        </Grid>

    </Grid>

</Window>
